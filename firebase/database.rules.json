{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "rooms": {
      ".read": "auth != null",
      "$room": {
        ".write": "auth != null"
      }
    },
    "moves": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists()",
        "$n": {
          ".write": "auth != null && !data.exists() && newData.isString() && newData.val().length < 64"
        }
      }
    }
  }
}
